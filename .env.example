# ---------------------------------------------------------------------------
# Base de données — PostgreSQL (Neon)
# ---------------------------------------------------------------------------
# DATABASE_URL : connexion via le pooler, utilisée par l'application au runtime.
#   postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&connection_limit=N
# `connection_limit` borne le pool Prisma *par instance* : sans lui, chaque
# instance serverless ouvre un pool dimensionné sur le nombre de CPU, et le
# total (instances concurrentes × pool par instance) peut dépasser ce que le
# pooler Neon autorise. En production (plusieurs instances Vercel), une valeur
# basse (1-3) est recommandée puisque le pooler (PgBouncer) multiplexe déjà les
# connexions ; en local, une valeur plus large (5) évite de sérialiser les
# requêtes d'un seul process de dev.
# DIRECT_URL   : connexion directe (sans `-pooler`), requise par `prisma migrate`.
DATABASE_URL=****
DIRECT_URL=****

# ---------------------------------------------------------------------------
# Chiffrement & environnement
# ---------------------------------------------------------------------------
# ENCRYPTION_KEY : clé AES-256-GCM encodée en base64 (32 octets) — utilisée
#   pour tout chiffrement neuf (`encryptionVersion = 2`).
# ENCRYPTION_KEY_LEGACY : ancienne clé AES-128-GCM encodée en base64 (16
#   octets) — conservée uniquement pour déchiffrer les secrets encore en
#   `encryptionVersion = 1`. Nécessaire tant que la base contient de telles
#   lignes (elles basculent automatiquement à la prochaine authentification
#   réussie qui les déchiffre) ; supprimable une fois qu'il n'en reste plus.
ENCRYPTION_KEY=****
ENCRYPTION_KEY_LEGACY=****
PUBLIC_ENV='dev'
SECRET_NAME_DATA_COOKIE=****

# ---------------------------------------------------------------------------
# OAuth Google
# ---------------------------------------------------------------------------
VITE_GOOGLE_REDIRECT_URI=http://localhost:2000/auth/login/google/callback
GOOGLE_CLIENT_ID=****
GOOGLE_CLIENT_SECRET=****

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=****
# En local : secret affiché par `stripe listen` (npm run dev). En prod : secret
# du endpoint Dashboard, pas celui du CLI.
STRIPE_WEBHOOK_SECRET=****
VITE_STRIPE_PUBLISHABLE_KEY=****

# ---------------------------------------------------------------------------
# Sendcloud
# ---------------------------------------------------------------------------
SENDCLOUD_BASE_URL=https://panel.sendcloud.sc
SENDCLOUD_PUBLIC_KEY=****
SENDCLOUD_SECRET_KEY=****
SENDCLOUD_INTEGRATION_ID=****
SENDCLOUD_SENDER_ADDRESS_ID=****
# SENDCLOUD_DEBUG=true

# Adresse d'expédition par défaut, utilisée pour le calcul des frais de port.
VITE_SHOP_FROM_COUNTRY=FR
VITE_SHOP_FROM_POSTAL=31000

# ---------------------------------------------------------------------------
# Emails transactionnels (SMTP Brevo)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=****
SMTP_PASS=****

# ---------------------------------------------------------------------------
# Médias & CMS
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=****
CLOUDINARY_API_KEY=****
CLOUDINARY_API_SECRET=****
PUBLIC_TINYMCE_API_KEY=****
SECRET_CONTENTFUL_SPACE_ID=****
SECRET_CONTENTFUL_ACCESS_TOKEN=****

# ---------------------------------------------------------------------------
# Géocodage
# ---------------------------------------------------------------------------
# Autocomplétion d'adresse via la Base Adresse Nationale (api-adresse.data.gouv.fr) :
# API publique du gouvernement français, sans clé. Cette variable ne sert qu'à
# activer le mock e2e (valeur `e2e` dans .env.test.example) — laissez `live` ici.
SECRET_ADDRESS_SEARCH_MODE=live

# ---------------------------------------------------------------------------
# Redis (Upstash) — rate limiting, cache, verrous d'idempotence
# ---------------------------------------------------------------------------
# Optionnelles en local : sans ces deux variables, `src/lib/server/redis.ts`
# fait retomber rate-limit/cache/lock sur un comportement en mémoire de
# process. En production (plusieurs instances Vercel), elles sont nécessaires
# pour que les quotas, le cache et les verrous soient réellement partagés.
UPSTASH_REDIS_REST_URL=****
UPSTASH_REDIS_REST_TOKEN=****

# ---------------------------------------------------------------------------
# Queue (Upstash QStash) — facture + Sendcloud après paiement, hors chemin
# synchrone du webhook Stripe
# ---------------------------------------------------------------------------
# Optionnelles en local : sans QSTASH_TOKEN (ou sans URL publique), le job
# post-paiement s'exécute directement, comme avant l'introduction de la queue.
# APP_URL n'est nécessaire que si le déploiement n'est pas sur Vercel (sinon
# VERCEL_URL sert de repli automatique) — c'est l'URL publique que QStash doit
# rappeler pour livrer le job, jamais localhost.
QSTASH_TOKEN=****
QSTASH_CURRENT_SIGNING_KEY=****
QSTASH_NEXT_SIGNING_KEY=****
APP_URL=****

# ---------------------------------------------------------------------------
# Purge programmée (/api/jobs/cleanup, voir $lib/server/jobs/cleanup.ts)
# ---------------------------------------------------------------------------
# Deux déclencheurs possibles pour le même endpoint :
# - QStash configuré (bloc ci-dessus) : lancer une fois
#   `npm run jobs:register-cleanup-schedule` pour enregistrer un Schedule
#   QStash (retry/backoff automatiques en cas d'échec) — CRON_SECRET n'est
#   alors pas nécessaire.
# - Sans QStash : Vercel Cron (`vercel.json`) ajoute automatiquement
#   `Authorization: Bearer $CRON_SECRET` à ses requêtes dès que cette variable
#   est définie sur le projet déployé (pas de retry natif côté Vercel).
CRON_SECRET=****

# ---------------------------------------------------------------------------
# Observabilité (Sentry, plan gratuit) — erreurs + traces, serveur et
# navigateur (src/hooks.server.ts, src/hooks.client.ts)
# ---------------------------------------------------------------------------
# Optionnelles en local : sans DSN, le SDK Sentry reste un no-op documenté
# (comportement identique à Redis/QStash absents ci-dessus). `SENTRY_DSN`
# (serveur) et `PUBLIC_SENTRY_DSN` (navigateur, préfixe `PUBLIC_` requis par
# SvelteKit pour être exposée au bundle client) proviennent du même projet
# Sentry — deux variables séparées car les DSN serveur/client peuvent différer
# selon la configuration du projet Sentry.
# SENTRY_AUTH_TOKEN / SENTRY_ORG / SENTRY_PROJECT ne servent qu'à l'upload des
# source maps en CI (voir vite.config.ts, désactivé par défaut) — inutiles en
# local ou sans ce besoin.
SENTRY_DSN=****
PUBLIC_SENTRY_DSN=****

